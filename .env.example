# Booking.com iCal export URL for your property.
# Find it in Booking.com extranet: Property > Rates & Availability > Export calendar.
# Keep this secret — it contains guest data.
BOOKING_ICAL_URL=https://ical.booking.com/v1/export?t=...

# Resend API key for sending transactional email.
# Create at https://resend.com — verify bnbdekopstoof.nl domain first.
RESEND_API_KEY=re_...
